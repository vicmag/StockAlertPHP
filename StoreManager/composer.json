{
    "name": "store-manager/phalcon-tdd",
    "description": "Phalcon TDD environment",
    "require": {
        "php": "^8.2",
        "phalcon/ide-stubs": "^5.0",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "StoreManager\\": "./"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testsuite=unit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
  }