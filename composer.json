{
  "name": "store-manager/store-manager",
  "description": "Aplicación para gestionar alertas de bajo stock en una tienda.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "StoreManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StoreManager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}