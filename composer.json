{
  "name": "yourname/phalcon-tdd",
  "description": "Phalcon TDD environment",
  "require": {
      "php": "^8.2",
      "phalcon/ide-stubs": "^5.0",
      "vlucas/phpdotenv": "^5.5",
      "monolog/monolog": "^3.0"
  },
  "require-dev": {
      "phpunit/phpunit": "^10.0"
  },
  "autoload": {
      "psr-4": {
          "App\\": "app/"
      }
  },
  "config": {
      "platform": {
          "php": "8.2"
      }
  },
  "scripts": {
      "test": "vendor/bin/phpunit --testsuite=unit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}